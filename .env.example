# ============================================================
# Braka Nusa Core — Frontend Environment Variables
# Copy to .env.local for local development.
# Vite only exposes variables prefixed with VITE_
# ============================================================

# API base URL (used when NOT using the Vite proxy)
# In development, the proxy in vite.config.js forwards /api → localhost:5000
# In production, set this to your backend's public URL.
VITE_API_BASE_URL=http://localhost:5000/api/v1
